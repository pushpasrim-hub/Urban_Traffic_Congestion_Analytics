# MySQL database used by the FastAPI backend
DB_HOST=localhost
DB_PORT=3306
DB_NAME=urban_traffic_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# Generate a unique value locally; do not commit the real secret.
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# Streamlit's server-side API client
API_BASE_URL=http://localhost:8000/api
FRONTEND_ORIGIN=http://localhost:8501
